{
  "name": "fastrag-workbench",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts *.json index.html",
    "format:check": "prettier --check src tests *.ts *.json index.html"
  },
  "dependencies": {
    "@lucide/vue": "^1.74.0",
    "dompurify": "^3.4.18",
    "marked": "^18.2.1",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.4"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
